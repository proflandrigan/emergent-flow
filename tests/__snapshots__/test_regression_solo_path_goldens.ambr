        "properties": {
          "x": {
            "default": 0.0,
            "title": "X",
            "type": "number"
          },
          "y": {
            "default": 0.0,
            "title": "Y",
            "type": "number"
          }
        },
        "title": "Position",
        "type": "object"
      }
    },
    "$ref": "#/$defs/Graph"
  }
  
