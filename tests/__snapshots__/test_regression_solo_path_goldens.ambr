# name: test_compile_response_golden
  dict({
    'code': '''
      """Generated by Emergent Flow. Do not edit by hand."""
      
      import emergentflow as ef
      
      
      def main() -> dict[str, object]:
          load_csv_frame = ef.data.load_csv(
              "examples/vertical_slice/sample.csv",
              encoding="utf-8",
              source_file=False,
              connection=None,
              expect_columns=None,
              expect_dtypes=None,
          )
          return {"load_csv_frame": load_csv_frame}
      
      
      if __name__ == "__main__":
          _results = main()
          for _name, _value in _results.items():
              print(f"{_name} = {_value!r}")
  
    ''',
  })
